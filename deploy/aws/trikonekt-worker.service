[Unit]
Description=Trikonekt Django background worker
After=network.target trikonekt-web.service

[Service]
Type=simple
User=trikonekt
Group=trikonekt
WorkingDirectory=/srv/trikonekt/app/backend
EnvironmentFile=/etc/trikonekt/backend.env
ExecStart=/srv/trikonekt/app/backend/.venv/bin/python manage.py process_tasks --max-runtime-seconds=50 --max-iterations=100 --sleep=0.5 --reap-on-start --reap-stuck-seconds=120
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/srv/trikonekt/app/backend/media /var/log/trikonekt

[Install]
WantedBy=multi-user.target

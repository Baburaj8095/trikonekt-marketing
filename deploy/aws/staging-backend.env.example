# Copy to /etc/trikonekt/staging-backend.env on EC2/Server.
# Keep real values out of Git.

DJANGO_SETTINGS_MODULE=core.settings
PYTHONUNBUFFERED=1

SECRET_KEY=replace-with-staging-secret-key
DEBUG=True

ALLOWED_HOSTS=staging-growth.vin,staging-api.growth.vin,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://staging-growth.vin,https://staging-api.growth.vin
CORS_ALLOWED_ORIGINS=https://staging-growth.vin
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.growth\.vin$

# Staging Database Connection (Isolated PostgreSQL Database)
DATABASE_URL=postgres://trikonekt_staging_user:replace-staging-password@localhost:5432/trikonekt_staging
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=0

# Mail Configuration (Set to False or use Sandbox SMTP for testing)
MAIL_ENABLED=False
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=contact@trikonekt.com
EMAIL_HOST_PASSWORD=replace-with-mail-password
DEFAULT_FROM_EMAIL=contact@trikonekt.com

# Throttle Limits for Staging
DRF_PAGE_SIZE=25
DRF_THROTTLE_ANON=300/min
DRF_THROTTLE_USER=1000/min

SKIP_HEAVY_ON_APPROVE=False
COUPON_DIST_BATCH=50
MONTHLY_759_BATCH=50

# Sandbox API Credentials
HUBBLE_SDK_BASE_URL=https://sdk-sandbox.myhubble.money

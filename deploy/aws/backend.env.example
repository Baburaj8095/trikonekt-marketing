# Copy to /etc/trikonekt/backend.env on EC2.
# Keep real values out of Git.

DJANGO_SETTINGS_MODULE=core.settings
PYTHONUNBUFFERED=1

SECRET_KEY=replace-with-production-secret
DEBUG=False

ALLOWED_HOSTS=growth.vin,www.growth.vin,admin.growth.vin,api.growth.vin
CSRF_TRUSTED_ORIGINS=https://growth.vin,https://www.growth.vin,https://admin.growth.vin,https://api.growth.vin
CORS_ALLOWED_ORIGINS=https://growth.vin,https://www.growth.vin,https://admin.growth.vin
CORS_ALLOWED_ORIGIN_REGEXES=^https://.*\.growth\.vin$

DATABASE_URL=postgres://trikonekt_admin:replace-password@replace-rds-endpoint:5432/trikonekt?sslmode=require
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=0
DB_CONNECT_TIMEOUT=10
DB_KEEPALIVES_IDLE=30
DB_KEEPALIVES_INTERVAL=10
DB_KEEPALIVES_COUNT=5

SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

MAIL_ENABLED=True
EMAIL_HOST=smtp.zoho.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=contact@trikonekt.com
EMAIL_HOST_PASSWORD=replace-with-mail-password
DEFAULT_FROM_EMAIL=contact@trikonekt.com
EMAIL_TIMEOUT=10
SERVER_EMAIL=contact@trikonekt.com

# Keep this if production uploads already use Cloudinary.
CLOUDINARY_URL=cloudinary://349997823579756:WEKV9ofFRGunlYnJqCyxW38ureo@dbfupwnqp

DRF_PAGE_SIZE=25
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=300/min
DRF_THROTTLE_HUBBLE_WEBHOOK=600/min

DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880

SKIP_HEAVY_ON_APPROVE=False
COUPON_DIST_BATCH=50
MONTHLY_759_BATCH=50

HUBBLE_SDK_BASE_URL=https://sdk.myhubble.money/experience-center
HUBBLE_CLIENT_ID=
HUBBLE_CLIENT_SECRET=
HUBBLE_APP_SECRET=
HUBBLE_JWT_PRIVATE_KEY_PEM=
HUBBLE_JWT_PRIVATE_KEY_PATH=
HUBBLE_WEBHOOK_SECRET=
HUBBLE_WEBHOOK_IP_ALLOWLIST=
